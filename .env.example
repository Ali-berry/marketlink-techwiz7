APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Chicago

# Powers the customer/farmer/admin AI agent widgets - get a free key at console.groq.com
# Two separate Groq accounts so a rate limit on one doesn't take the agents down -
# see App\Services\Agent\GroqClient, which tries primary first, then secondary.
GROQ_API_KEY_PRIMARY=
GROQ_API_KEY_SECONDARY=
GROQ_MODEL=openai/gpt-oss-120b

# Powers the "Area / Location" autocomplete on registration - get a key at
# console.cloud.google.com (enable the Places API). Leave empty to fall back to a
# plain text input, no error either way.
GOOGLE_MAPS_API_KEY=

# "Continue with Google" sign-in (Socialite) - create an OAuth 2.0 Client ID at
# console.cloud.google.com, authorized redirect URI is GOOGLE_REDIRECT_URI below.
# Login/register hide the Google button until these are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

# Checks a new email can really receive mail (sign-up and email change) - get a key
# for the Email Validation API at abstractapi.com. Leave empty to use only Laravel's
# basic email:rfc,dns check, sign-up keeps working either way.
ABSTRACT_EMAIL_VALIDATION_API_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

